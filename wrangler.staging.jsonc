// Staging hybrid Worker for staging.purplelife.org (name stays `purplelife-staging`).
// Same route split as www after PR #57: ploy-staging/worker/www-entry.ts
//   /api/* + /oauth/* → TanStack in-process (real auth and D1/R2)
//   other UI          → Ploy Astro live copy (not design-preview)
//
// Same production D1/R2/KV as Worker `purplelife`. No cron triggers: prod owns
// schedules, and a second trigger would double-run against the shared database.
// No PROD service proxy and no design-preview user.
//
// Operator deploy only (docs/DEPLOY-STAGING-PLOY.md). Do not wrangler deploy
// from a cloud agent.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purplelife-staging",
  "account_id": "08e766e92db74bc7ef14c6b5c86bddf0",
  "workers_dev": true,
  "routes": [{ "pattern": "staging.purplelife.org/*", "zone_name": "purplelife.org" }],
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "ploy-staging/worker/www-entry.ts",
  "assets": {
    "directory": "ploy-staging/dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "services": [{ "binding": "SELF", "service": "purplelife-staging" }],
  "vars": {
    "DESIGN_PREVIEW": "0",
    "STAGING_REAL_AUTH": "1",
    "DATA_BACKEND": "cloudflare",
    "STAGING_LIVE_DATA": "1",
    "PUBLIC_SITE_URL": "https://staging.purplelife.org",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purplelifeai",
      "database_id": "8d0be2b3-84ec-4581-86f4-6b372ec1d5d7",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "purplelifeai",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "9226585702aa4be694ac74981d9859c4",
    },
  ],
}
