# Copy to .env and fill in before running import or storage scripts.
# Use Session pooler URLs (port 5432), not Transaction pooler (port 6543).

# Old Lovable Supabase project (exports + baseline counts)
OLD_DB_URL=postgresql://postgres.<old-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# New Supabase project (imports + verification)
NEW_DB_URL=postgresql://postgres.<new-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
NEW_SUPABASE_URL=https://<new-ref>.supabase.co
NEW_SERVICE_ROLE_KEY=<service_role_secret>
