---
import Layout from "../../layouts/Layout.astro";
import RecordPage from "../../components/pages/record-mobile/page";
export const prerender = true;
export const ployPreviewParams = { postId: "appointment-preparation" };
export function getStaticPaths() { return [{ params: ployPreviewParams }]; }
const { postId = "appointment-preparation" } = Astro.params;
---
<Layout title="Community discussion · PurpleLife" noindex={true}><RecordPage kind="community-post" recordId={postId} client:load /></Layout>
