// Deploy config for the built output. The root wrangler.jsonc stays pointed at
// src/server.ts because the Cloudflare vite plugin reads it at build time.
// Usage: bun run build && wrangler deploy -c wrangler.deploy.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purplelife",
  "account_id": "c7f99ecba0ace852de43684ec8a44612",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.purplelife.org/*", "zone_name": "purplelife.org" },
    { "pattern": "purplelife.org/*", "zone_name": "purplelife.org" },
  ],
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Self service binding so the scheduled handler can invoke the app's own
  // cron endpoints without a same-zone subrequest loop.
  "services": [{ "binding": "SELF", "service": "purplelife" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purplelifeai",
      "database_id": "bfb642b9-b71b-4d7f-a823-669efc2f2168",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "purplelifeai",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "73356a0e339447059bdddc33b93f26a9",
    },
  ],
  "triggers": {
    // Mapped to endpoints in the scheduled handler (src/server.ts).
    "crons": [
      "* * * * *", // dose reminders
      "0 * * * *", // wearable syncs (Oura, Whoop)
      "0 6 * * *", // daily jobs (care digest, medical reports, account purge)
      "0 15 * * 7", // weekly recap (Sunday)
    ],
  },
}
