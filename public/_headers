# Served by Cloudflare Workers static assets (honors Pages-style header rules).
# Hashed build output is immutable; cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and og image change rarely; revalidate daily.
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/og-cover.jpg
  Cache-Control: public, max-age=86400

# Never cache the service worker shell so updates roll out promptly.
/sw.js
  Cache-Control: no-cache
